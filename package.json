{
  "name": "opentakeoff-academy",
  "version": "0.1.0",
  "description": "Conformance SDK + CLI for OpenTakeoff Academy — an open benchmark & certification harness for construction-takeoff AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://union.kentucky-ai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kentucky-ai/opentakeoff-academy.git"
  },
  "bugs": {
    "url": "https://github.com/Kentucky-ai/opentakeoff-academy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "opentakeoff-academy": "src/cli.js",
    "opentakeoff-env": "src/ot-env-mcp.js",
    "union-marketplace": "src/marketplace-mcp.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "schema/",
    "README.md",
    "LICENSE",
    "site/marketplace-contract.js",
    "site/data/marketplace.json"
  ],
  "scripts": {
    "test": "node examples/my-agent.example.js --selftest && node test/ot-backend.test.mjs && node test/groundtruth.test.mjs && node test/stats.test.mjs && node test/agreement.test.mjs && node test/env-serve.test.mjs && node test/providers.test.mjs",
    "test:ot-live": "node scripts/ot-parity.mjs",
    "serve:agent": "node examples/my-agent.example.js --serve",
    "serve:env": "node src/ot-env-mcp.js",
    "cli": "node src/cli.js",
    "test:lab": "node --test test/real-plan-lab.test.mjs",
    "test:commerce": "node --test test/commerce.test.mjs",
    "test:marketplace": "node --test test/marketplace.test.mjs test/marketplace-mcp.test.mjs",
    "serve:marketplace": "node src/marketplace-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "zod": "4.6.7"
  },
  "keywords": [
    "construction",
    "takeoff",
    "benchmark",
    "certification",
    "mcp",
    "agents",
    "evaluation"
  ],
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}

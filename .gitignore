# dependencies
node_modules/
package-lock.json
npm-debug.log*
yarn.lock
pnpm-lock.yaml

# entrant run artifacts (keep the dir, ignore generated bundles/reports)
runs/*.json
runs/*.bundle.json
runs/*.svg
!runs/.gitkeep

# keys & secrets — NEVER commit signing material
*.pem
*.key
keys/
# ...except the Academy's PUBLIC verification key, which is the whole point:
# a credential nobody can check is not a credential. Private halves are
# generated in memory and never written to disk (scripts/regen-sample-data.mjs).
!site/academy-public-key.pem
.env
.env.*

# scratch / OS
*.log
.DS_Store
coverage/
.tmp/
tmp/

# real source plansets — private held-out ground-truth material, NOT for publication
plans/

# held-out ground-truth answer keys — never published
**/ground-truth/

# internal validation run (Opus) + rough harness — not for the public board yet
scripts/contestant-af101-takeoff.json
scripts/measure-af101.mjs
scripts/discover.mjs
scripts/wire-smoke.mjs

# internal session closeouts / working notes — for our own pickup, NOT for the
# public repo (may reference strategy, moat, or held-out numbers)
docs/SESSION-*.md
